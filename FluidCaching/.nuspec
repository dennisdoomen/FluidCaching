<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <!-- 👇 This is the ID of the package in NuGet -->
    <id>FluidCaching</id>
    <version>$version$</version>
    <!-- 👇 Indicates the package is only used at build time, not deploy time -->
    <developmentDependency>true</developmentDependency>
    <authors>Dennis Doomen</authors>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/dennisdoomen/FluidCaching</projectUrl>
    <repository type="git" url="https://github.com/dennisdoomen/FluidCaching" />
    <description>A content-only package with a multi-threaded, high-performance Least Recently Used (LRU) cache with async/await support. Requires C# 10 or later.</description>
    <tags>source LRU caching cache</tags>
    <readme>Readme.md</readme>
    <releaseNotes>https://github.com/dennisdoomen/FluidCaching/releases</releaseNotes>
    <copyright>Copyright 2015-$year$ Dennis Doomen</copyright>
  </metadata>
  <files>
    <!-- 👇 Trimmed README generated by the PreparePackageReadme build target -->
    <file src="..\Artifacts\Readme.md" target="" />
    <file src="*.cs" target="contentFiles/cs/net47/FluidCaching/" />
    <file src="*.cs" target="contentFiles/cs/net10.0/FluidCaching/" />
    <!-- 👇 Used by all other target frameworks, such as netstandard2.0 or net8.0 -->
    <file src="*.cs" target="contentFiles/cs/any/FluidCaching/" />
    <!-- 👇 Hide content files from Visual Studio solution explorer -->
    <file src="FluidCaching.props" target="build/FluidCaching.props" />
  </files>
</package>
